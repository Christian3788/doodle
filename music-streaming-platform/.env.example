# Database & Cache
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/spotify_db?schema=public"
REDIS_URL="redis://localhost:6379"

# S3 / MinIO Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="spotify-audio"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="miniopassword"

# Audio Streaming Gateway
AUDIO_SERVICE_PORT=8080
NEXT_PUBLIC_STREAM_URL="http://localhost:8080/stream"
NEXT_PUBLIC_WS_URL="ws://localhost:8080/ws"

# Authentication
NEXTAUTH_SECRET="super-secret-random-32-char-key-for-jwt-signing"
NEXTAUTH_URL="http://localhost:3000"